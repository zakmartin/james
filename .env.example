# ===== JamesApp.cz — konfigurace =====

# Port serveru
PORT=3000

# Doručení leadů z demo formuláře.
# Web skupiny aktuálně používá webhook na centrální lead-service / CRM.
LEAD_DELIVERY=webhook

# Cílový endpoint, kam se přeposílá JSON s leadem (POST).
FORM_API_URL=https://lead-service.cfg.cz/api/leads

# Volitelný sdílený token přidaný do hlavičky Authorization: Bearer <...>
FORM_API_TOKEN=

# Veřejná URL registrace trialu (cíl tlačítka „Vyzkoušet zdarma" / 301 z /registrace)
REGISTRACE_URL=https://emitent.jamesapp.cz
